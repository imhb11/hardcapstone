<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">


    <ImageView
        android:id="@+id/meeting_back1"
        android:layout_width="34dp"
        android:layout_height="33dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/meeting_backbutton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="12dp"
        android:text="소모임 만들기"
        android:textSize="21dp"
        android:fontFamily="@font/pretendard"
        app:layout_constraintStart_toEndOf="@+id/meeting_back1"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/imageButton"
        android:layout_width="28dp"
        android:layout_height="33dp"
        android:layout_marginStart="188dp"
        android:layout_marginTop="12dp"
        android:background="@android:color/transparent"
        app:layout_constraintStart_toEndOf="@+id/textView2"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/alarm" />

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="368dp"
        android:layout_height="26dp"
        android:layout_marginTop="100dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.488"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Step 1 -->
        <TextView
            android:id="@+id/step1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/step_circle_filled"
            android:gravity="center"
            android:text="1"
            android:textColor="@android:color/white" />

        <!-- Dotted line or view -->

        <!-- Step 2 -->

        <View
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:background="@drawable/dotted_line" />

        <TextView
            android:id="@+id/step2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/step_circle_filled"
            android:gravity="center"
            android:text="2"
            android:textColor="@android:color/white" />
        <!-- Dotted line or view -->

        <!-- Step 2 -->

        <View
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:background="@drawable/dotted_line" />

        <TextView
            android:id="@+id/step3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/step_circle_empty"
            android:gravity="center"
            android:text="3"
            android:textColor="@android:color/white" />
        <!-- Dotted line or view -->
        <View
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:background="@drawable/dotted_line" />

        <!-- Step 2 -->
        <TextView
            android:id="@+id/step4"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/step_circle_empty"
            android:gravity="center"
            android:text="4"
            android:textColor="@android:color/white" />
        <!-- Dotted line or view -->
        <View
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:background="@drawable/dotted_line" />

        <!-- Step 2 -->
        <TextView
            android:id="@+id/step5"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/step_circle_empty"
            android:gravity="center"
            android:text="5"
            android:textColor="@android:color/white" />
        <!-- Dotted line or view -->
        <View
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:background="@drawable/dotted_line" />

        <!-- Step 2 -->
        <TextView
            android:id="@+id/step6"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/step_circle_empty"
            android:gravity="center"
            android:text="6"
            android:textColor="@android:color/white" />

        <!-- 나머지 단계도 반복 -->
    </LinearLayout>

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.256"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2"
        app:srcCompat="@drawable/meeting_write_currentlevel" />

    <TextView
        android:id="@+id/categorytext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:fontFamily="@font/pretendard"
        android:text="음식"
        android:textColor="#FF9861"
        android:textSize="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.084"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="76dp"
        android:fontFamily="@font/pretendard"
        android:text="중에서도"
        android:textColor="#4D3005"
        android:textSize="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.313"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/pretendard"
        android:text="우리 모임의 주제는..."
        android:textColor="#4D3005"
        android:textSize="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.162"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView4" />

    <ImageButton
        android:id="@+id/nextbtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/textView6"
        app:layout_constraintTop_toBottomOf="@+id/buttonContainer"
        app:srcCompat="@drawable/meeting_write_nextbutton" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="228dp"
        android:layout_marginTop="48dp"
        android:text="다음으로 넘어가기"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonContainer" />

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@+id/textView5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:flexWrap="wrap"
        app:justifyContent="flex_start"
        app:alignItems="flex_start">
    </com.google.android.flexbox.FlexboxLayout>


</androidx.constraintlayout.widget.ConstraintLayout>